# URL pública de la app (sin barra final)
APP_URL=http://localhost:3000

# Secreto para firmar la cookie de sesión: openssl rand -base64 32
SESSION_SECRET=

# OAuth de Google (redirect: $APP_URL/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth de Microsoft Entra (redirect: $APP_URL/api/auth/microsoft/callback)
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Solo para scripts/export-roster.ts: base de People, de solo lectura
PEOPLE_DATABASE_URL=

# Contraseña compartida del login (solo el hash). La de desarrollo es Test1234!: npm run password -- 'la-clave' para cambiarla
LOGIN_PASSWORD_HASH=scrypt:IOuqnVYjPOacfCWjEnmqbg:b4vMgy1s3C6Jj3zkJ1bD8rHS45g8JGGxZldsMnx7Szw

# Fiesta (ISO con zona). La carga abre 5 días antes: ahí sale el mail.
EVENT_DATE=2026-12-11T20:00:00-03:00

# Opcional: el equipo como JSON (mismo formato que data/equipo.json), para servidores sin archivos
EQUIPO_JSON=

# Opcional: dónde van la base y las fotos (por defecto storage/; en Vercel, /tmp/medio-watts)
STORAGE_DIR=

# Login: por ahora la app está abierta (se entra como visitante). Con LOGIN=on vuelve a pedir mail y contraseña.
LOGIN=
